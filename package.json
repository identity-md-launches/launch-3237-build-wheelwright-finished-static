{
  "name": "wheelwright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/formula.test.js && node --import tsx --test test/protocol.test.ts test/game.test.ts",
    "recompute": "node --import tsx scripts/recompute.ts",
    "check:browser": "node scripts/validate-browser.mjs",
    "check:export": "node scripts/check-export.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "tsx": "4.20.6",
    "@playwright/test": "1.56.1"
  }
}
